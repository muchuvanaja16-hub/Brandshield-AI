# Credentials live here; DO NOT commit this file with real values.
# Copy to .env and adjust. Database URL scheme for Phase 2 = SQLite (default)
# or mysql+pymysql://user:pass@host:3306/brandshield for Phase 3 MySQL.
BRANDSHIELD_DATABASE_URL=sqlite:///./backend/brandshield.db
BRANDSHIELD_SESSION_COOKIE=brandshield_session
BRANDSHIELD_COOKIE_SECURE=false
BRANDSHIELD_SESSION_HOURS=12
BRANDSHIELD_DEMO_MODE=true
PORT=5000
